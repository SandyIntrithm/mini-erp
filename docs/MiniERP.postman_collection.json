{
  "info": {
    "name": "Mini ERP API",
    "description": "Inventory & Purchase Order Lifecycle API (Laravel Sanctum). Run 'Login' first - it stores the bearer token in the {{token}} collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "po_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) { pm.collectionVariables.set('token', body.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/me", "host": ["{{base_url}}"], "path": ["api", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/logout", "host": ["{{base_url}}"], "path": ["api", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Inventory (paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/inventory?per_page=15&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "inventory"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "page", "value": "1" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Low stock",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/inventory/low-stock", "host": ["{{base_url}}"], "path": ["api", "inventory", "low-stock"] }
          }
        },
        {
          "name": "Suppliers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/suppliers", "host": ["{{base_url}}"], "path": ["api", "suppliers"] }
          }
        }
      ]
    },
    {
      "name": "Purchase Orders",
      "item": [
        {
          "name": "List purchase orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/purchase-orders?status=RECEIVED",
              "host": ["{{base_url}}"],
              "path": ["api", "purchase-orders"],
              "query": [{ "key": "status", "value": "RECEIVED" }]
            }
          }
        },
        {
          "name": "Create purchase order (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('po_id', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": 1,\n  \"order_date\": \"2026-10-03\",\n  \"notes\": \"Restock scanner batteries\",\n  \"items\": [\n    { \"product_id\": 6, \"quantity\": 20, \"unit_price\": 29.50 },\n    { \"product_id\": 5, \"quantity\": 10, \"unit_price\": \"18.00\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/purchase-orders", "host": ["{{base_url}}"], "path": ["api", "purchase-orders"] }
          }
        },
        {
          "name": "Create purchase order - validation error (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"supplier_id\": 1,\n  \"items\": []\n}" },
            "url": { "raw": "{{base_url}}/api/purchase-orders", "host": ["{{base_url}}"], "path": ["api", "purchase-orders"] }
          }
        },
        {
          "name": "Show purchase order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/purchase-orders/{{po_id}}", "host": ["{{base_url}}"], "path": ["api", "purchase-orders", "{{po_id}}"] }
          }
        },
        {
          "name": "Update DRAFT purchase order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": 1,\n  \"items\": [\n    { \"product_id\": 6, \"quantity\": 25, \"unit_price\": 29.00 }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/purchase-orders/{{po_id}}", "host": ["{{base_url}}"], "path": ["api", "purchase-orders", "{{po_id}}"] }
          }
        },
        {
          "name": "Approve",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"APPROVED\" }" },
            "url": { "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/status", "host": ["{{base_url}}"], "path": ["api", "purchase-orders", "{{po_id}}", "status"] }
          }
        },
        {
          "name": "Mark as received (updates stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"RECEIVED\" }" },
            "url": { "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/status", "host": ["{{base_url}}"], "path": ["api", "purchase-orders", "{{po_id}}", "status"] }
          }
        },
        {
          "name": "Cancel",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"CANCELLED\" }" },
            "url": { "raw": "{{base_url}}/api/purchase-orders/{{po_id}}/status", "host": ["{{base_url}}"], "path": ["api", "purchase-orders", "{{po_id}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Supplier spend (RECEIVED orders)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/reports/supplier-spend", "host": ["{{base_url}}"], "path": ["api", "reports", "supplier-spend"] }
          }
        }
      ]
    }
  ]
}
